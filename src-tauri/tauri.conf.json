{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "localmusicapp",
  "version": "0.1.0",
  "identifier": "com.llq.localmusicapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "localmusicapp",
        "width": 1100,
        "height": 750,
        "minWidth": 860,
        "minHeight": 600,
        "backgroundColor": "#1e1e1e",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
